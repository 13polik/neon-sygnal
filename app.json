{
  "expo": {
    "name": "Neon Sygnał",
    "slug": "neon-sygnal",
    "version": "1.8.2",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.polik13.neonsygnal",
      "buildNumber": "11"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-alternate-app-icons",
        [
          {
            "name": "Mira",
            "ios": "./assets/icons/mira.png",
            "android": {
              "foregroundImage": "./assets/icons/mira.png",
              "backgroundColor": "#07080f"
            }
          },
          {
            "name": "Wieza",
            "ios": "./assets/icons/wieza.png",
            "android": {
              "foregroundImage": "./assets/icons/wieza.png",
              "backgroundColor": "#07080f"
            }
          },
          {
            "name": "Sokol",
            "ios": "./assets/icons/sokol.png",
            "android": {
              "foregroundImage": "./assets/icons/sokol.png",
              "backgroundColor": "#07080f"
            }
          },
          {
            "name": "Dolina",
            "ios": "./assets/icons/dolina.png",
            "android": {
              "foregroundImage": "./assets/icons/dolina.png",
              "backgroundColor": "#07080f"
            }
          }
        ]
      ],
      "expo-asset"
    ],
    "backgroundColor": "#07080f"
  }
}
